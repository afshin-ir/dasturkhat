{
  "schema_version": 1,
  "source": {
    "title": "دستور خط فارسی",
    "institution": "فرهنگستان زبان و ادب فارسی"
  },
  "rules": [
    {
      "id": "progressive_verb_prefix",
      "status": "audited",
      "printed_pages": [
        40
      ],
      "applies_to": "پیشوند فعلیِ می/نمی/همی، هنگامی که جزءِ فعل است",
      "required_separator": "نیم‌فاصله",
      "preferred_examples": [
        "می‌رود",
        "می‌شود",
        "نمی‌رسد",
        "نمی‌شود",
        "همی‌گوید"
      ],
      "nonpreferred_examples": [
        "میرود",
        "می رود",
        "میشود",
        "می شود",
        "نمی رسد",
        "همی گوید"
      ],
      "exceptions": [
        "«همی» اگر نشانهٔ تأکید و واژه‌ای مستقل باشد، با فاصلهٔ کامل می‌آید؛ نمونهٔ کتاب: «همی نیست»."
      ]
    },
    {
      "id": "plural_suffix_ha",
      "status": "audited",
      "printed_pages": [
        41,
        42
      ],
      "applies_to": "پسوند جمعِ «ها» در پیوند با واژهٔ پیشین",
      "accepted_forms": [
        "پیوسته",
        "با نیم‌فاصله",
        "با فاصلهٔ کامل"
      ],
      "recommended_form": "با نیم‌فاصله",
      "preferred_examples": [
        "کتاب‌ها"
      ],
      "nonpreferred_examples": [
        "کتابها",
        "کتاب ها"
      ],
      "exceptions": [
        "کتاب برای آموزش یا برجسته‌سازی جزء نخست جدا نوشته می‌شود.",
        "برخی دسته‌ها در کتاب الزاماً جدا نوشته می‌شوند؛ مانند موارد پس از واژه‌های بیگانه، جمع اسم خاص، واژه‌های پردندانه و واژه‌های پایان‌یافته به «ه» یا «ی»."
      ]
    }
  ]
}
